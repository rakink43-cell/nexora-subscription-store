# ---------------------------------------------------------------------------
# NEXORA — environment variables
# Copy to `.env` locally; add the same two VITE_ keys in Cloudflare Pages.
# ---------------------------------------------------------------------------

# Public Supabase project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable (anon) key — safe for the browser, protected by RLS policies.
# NEVER use a secret/service_role key here: this bundle ships to every visitor.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional storefront fallbacks (website_settings in the DB always wins)
VITE_SUPPORT_WHATSAPP=01575864415
VITE_SUPPORT_EMAIL=nexora.sub01@gmail.com

# Optional: set to true to run the storefront on bundled demo data with no
# database at all (used by the e2e suite). Leave unset for normal operation.
# VITE_DEMO_MODE=true
